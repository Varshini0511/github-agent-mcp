GROQ_API_KEY=your_groq_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# --- Required ---------------------------------------------------------
# GitHub token (fine-grained PAT). Read-only is enough to explore repos;
# writes additionally need Contents + Pull requests + Issues: read & write.
GITHUB_TOKEN=your_github_token_here

# --- Model ------------------------------------------------------------
# Any "<provider>:<model>" understood by LangChain's init_chat_model.
# CHAT_MODEL=google_genai:gemini-flash-lite-latest
# CHAT_MODEL=groq:openai/gpt-oss-120b
# EMBEDDING_MODEL=models/gemini-embedding-001

# --- Safety -----------------------------------------------------------
# Writes are OFF unless you opt in. Even when on, every write also needs an
# explicit human approval.
ALLOW_WRITES=false
# Redact emails / phone numbers / card numbers from tool output and answers.
# GUARDRAILS_REDACT_PII=true
# Self-critique pass: fact-check each answer against tool output and revise
# once if needed. Costs one extra model call per answer.
# ENABLE_REFLECTION=false

# --- Retrieval --------------------------------------------------------
# Hybrid = BM25 + embeddings fused with Reciprocal Rank Fusion.
# RAG_HYBRID=true
# RAG_CANDIDATES=20

# --- Limits & persistence ---------------------------------------------
# AGENT_RUN_LIMIT=25
# CHECKPOINT_DB=agent_memory.sqlite
# MEMORY_DB=agent_longterm.sqlite
# VECTOR_DIR=vector_store

# --- HTTP API (api.py) ------------------------------------------------
# With API_KEY set, requests must send it as X-API-Key. Without it, only
# loopback clients are accepted.
# API_KEY=generate-a-long-random-string
# API_RATE_LIMIT_PER_MIN=30

# --- CI webhook / auto-triage (api.py) --------------------------------
# POST /webhooks/github lets a failed GitHub Actions run trigger the agent.
# The endpoint stays disabled (503) until this secret is set; it must match
# the secret you enter when creating the webhook on GitHub.
# GITHUB_WEBHOOK_SECRET=generate-a-long-random-string
# Auto-diagnose on failure (one model run per failed run). OFF = only record
# failures. Fixing is never automatic: it still goes through code_writer with
# human approval.
# CI_AUTO_TRIAGE=false
# Hard cap on automatic triage runs per commit (a failure-storm brake).
# CI_AUTO_TRIAGE_MAX_PER_COMMIT=2

# --- Observability ----------------------------------------------------
# LOG_LEVEL=INFO
# Override the cost estimator (USD per 1M tokens: [input, output]):
# MODEL_PRICES_JSON={"gemini": [0.30, 2.50]}
# Optional tracing to LangSmith (no code changes needed):
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your_langsmith_key
# LANGSMITH_PROJECT=github-agent
